# Server-only URL for the FastAPI service. Leave blank for example dashboard data.
BACKEND_URL=
# Use "none" with local uvicorn or "google-oidc" with private Cloud Run.
BACKEND_AUTH=none

# --- Firebase project (Authentication + Web app) ---
# Server-only Firebase project identifier. Token verification uses no stored key.
FIREBASE_PROJECT_ID=<firebase-project-id>

# Public Firebase Web App identifiers. These are bundled into the browser and
# are not secrets; access control comes from Firebase Auth and server verification.
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<firebase-project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<firebase-project-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<firebase-web-app-id>

# --- Cloud Run project (the one running shellhacks-api; may differ from Firebase) ---
# Server-only Workload Identity Federation configuration for Vercel -> Google Cloud.
# Only needed with BACKEND_AUTH=google-oidc (Vercel Production).
GCP_PROJECT_NUMBER=<cloud-run-project-number>
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=<vercel-provider-id>
GCP_SERVICE_ACCOUNT_EMAIL=vercel-frontend@<cloud-run-project-id>.iam.gserviceaccount.com

# Optional: leave empty to use the OpenFreeMap basemap.
NEXT_PUBLIC_MAPTILER_KEY=
