# Snowflake settings for `python -m backend.documentparsing` and `python -m backend.projectdata`.
# Copy to backend/.env.snowflake (gitignored) and replace every <placeholder>.
# The CLI does not read this file itself; load it into the process environment first.

# --- Required ---
# Snowsight -> bottom-left account menu -> Account -> "Account identifier" (orgname-accountname).
# Not a URL. Replace any "_" with "-".
SNOWFLAKE_ACCOUNT=<orgname-accountname>
# The Snowflake user the token belongs to.
SNOWFLAKE_USER=<snowflake-username>
# Programmatic Access Token: Snowsight -> your user -> Programmatic access tokens -> Generate.
# The user must be covered by a network policy or the token is rejected. SECRET - never commit.
SNOWFLAKE_TOKEN=<programmatic-access-token>
# A warehouse the role below has USAGE on.
SNOWFLAKE_WAREHOUSE=<warehouse-name>

# --- Recommended ---
# Must be granted to SNOWFLAKE_USER and able to CREATE DATABASE (e.g. SYSADMIN) for `setup`.
SNOWFLAKE_ROLE=<role-name>

# --- Optional (explicit values make local setup reproducible) ---
# Database created by `setup`; use the desired Snowflake database name.
SNOWFLAKE_DATABASE=<construction-collab-database>
# Schema created by `setup` in that database.
SNOWFLAKE_SCHEMA=<schema-name>
# Stage created by `setup` in that schema.
SNOWFLAKE_STAGE=<stage-name>
# SQL API timeout in seconds (1 through 3600).
SNOWFLAKE_STATEMENT_TIMEOUT=<seconds-1-to-3600>
# Database name for the reference dataset created by the project-data pipeline.
GRIDLOCK_REFERENCE_DATABASE=<reference-database>
# Database name for uploaded plan data created by the project-data pipeline.
GRIDLOCK_UPLOAD_DATABASE=<upload-database>
# Schema name used in both Gridlock databases.
GRIDLOCK_DATA_SCHEMA=<data-schema>
