# Set these in your shell; the CLI deliberately does not read .env automatically.
SNOWFLAKE_ACCOUNT=organization-account
SNOWFLAKE_USER=CONSTRUCTION_APP
SNOWFLAKE_TOKEN=replace-with-programmatic-access-token
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CONSTRUCTION_COLLAB
SNOWFLAKE_SCHEMA=APP
SNOWFLAKE_STAGE=DOCUMENTS_STAGE
SNOWFLAKE_ROLE=CONSTRUCTION_APP_ROLE
SNOWFLAKE_STATEMENT_TIMEOUT=300
