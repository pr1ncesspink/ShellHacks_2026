# Copy to cloudrun.env (which is local-only) and set the owner-provided project ID.
GCP_PROJECT_ID=replace-with-owner-project-id
GCP_REGION=us-east1
SERVICE_NAME=shellhacks-api
AR_REPO=shellhacks
# Private is the default. Set CLOUDRUN_PUBLIC=1 only with owner approval; it
# makes the service reachable by anyone on the internet.
CLOUDRUN_PUBLIC=0
# Documentation only: deployment and environment changes are deferred.
# COLLISION_SOURCE=csv
# COLLISION_EXPORT_DIR=backend/documentparsing/outputs
# DIAGNOSIS_TRANSPORT=inprocess
# DIAGNOSIS_A2A_URL=http://localhost:8000/a2a/diagnosis
# DIAGNOSIS_A2A_PUBLIC_URL=http://localhost:8000/a2a/diagnosis
# DIAGNOSIS_SEED=2026
# DIAG_MAX_DISTANCE_MI=15
# DIAG_MAX_GAP_DAYS=1095
# DIAG_CO_SCHEDULE_MIN_SIM=0.45
# Agent limits are per instance. max-instances=3 gives 3 x 25 = 75 requests/min.
# Runtime environment values below are documentation only; a human sets them
# on Cloud Run. cloudrun.sh does not forward them from this file.
# AGENT_RATE_LIMIT_PER_CLIENT=45
# AGENT_RATE_LIMIT_TOTAL=25
# RATE_LIMIT_TRUSTED_PROXY_HOPS=1
# RATE_LIMIT_USER_HEADER=
# A limit of 0 disables that bucket; both 0 disables middleware. Proxy hops 0
# uses the connection IP. Negative/non-integer numeric values fail startup.
# Enable this UID header ONLY on private Cloud Run (--no-allow-unauthenticated,
# CLOUDRUN_PUBLIC=0), where the Vercel server verifies Firebase users and
# forwards the trusted X-Authenticated-User header (HARNESS-NEXT-FRONTEND-001).
# RATE_LIMIT_USER_HEADER=X-Authenticated-User
# --- Opt-in runtime config forwarded by cloudrun.sh (HARNESS-DEPLOY-SNOWFLAKE-GEMINI-001) ---
# Uncomment to forward these non-secret values with --update-env-vars. Leaving
# them all commented keeps today's deploy unchanged. Values must not contain
# commas or newlines. See OWNER_SETUP.md "Runtime secrets and Gemini".
# NEVER put SNOWFLAKE_TOKEN (or GOOGLE_API_KEY) here: cloudrun.sh ignores them.
# The Snowflake PAT lives only in Secret Manager and reaches Cloud Run through
# --update-secrets=SNOWFLAKE_TOKEN=<SNOWFLAKE_TOKEN_SECRET>:<version>.
# Snowflake is all-or-nothing: ACCOUNT, USER, WAREHOUSE and TOKEN_SECRET together.
# SNOWFLAKE_ACCOUNT=replace-with-org-account
# SNOWFLAKE_USER=replace-with-snowflake-user
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=SYSADMIN
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_STAGE=
# SNOWFLAKE_STATEMENT_TIMEOUT=
# GRIDLOCK_REFERENCE_DATABASE=
# GRIDLOCK_UPLOAD_DATABASE=
# GRIDLOCK_DATA_SCHEMA=
# SNOWFLAKE_TOKEN_SECRET=snowflake-pat
# SNOWFLAKE_TOKEN_SECRET_VERSION=latest
# Gemini on Vertex AI through the runtime service account (ADC, no API key).
# GEMINI_BACKEND=vertex sets GOOGLE_GENAI_USE_VERTEXAI=TRUE and
# GOOGLE_CLOUD_PROJECT=$GCP_PROJECT_ID; GOOGLE_CLOUD_LOCATION is required.
# GEMINI_BACKEND=vertex
# GOOGLE_CLOUD_LOCATION=global
# DIAGNOSIS_MODEL=gemini-3.1-flash-lite
# Dedicated runtime identity (secretAccessor on snowflake-pat + aiplatform.user).
# CLOUDRUN_SERVICE_ACCOUNT=shellhacks-api-runtime@shellhacks-2026.iam.gserviceaccount.com
