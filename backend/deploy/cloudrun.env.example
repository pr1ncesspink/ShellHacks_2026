# Copy to cloudrun.env (which is local-only) and set the owner-provided project ID.
GCP_PROJECT_ID=replace-with-owner-project-id
GCP_REGION=us-east1
SERVICE_NAME=shellhacks-api
AR_REPO=shellhacks
# Set PUBLIC=0 when the organization disallows public Cloud Run services.
# On Windows, CLOUDRUN_PUBLIC=0/1 avoids the inherited PUBLIC folder variable.
PUBLIC=1
